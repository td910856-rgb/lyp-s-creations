# ===== 复制这个文件为 .env，然后填入你自己的真实值 =====
# .env 已经在 .gitignore 里，不会被提交，API Key 永远不要写进代码

# 模型服务商提供的密钥
LLM_API_KEY=

# 接口地址：
#   OpenAI     -> https://api.openai.com/v1
#   DeepSeek   -> https://api.deepseek.com/v1
#   通义千问    -> https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://api.openai.com/v1

# 模型名，例如 gpt-4o-mini / deepseek-flash / qwen-plus
LLM_MODEL=gpt-4o-mini

# 调试开关：设为 1 时完全不调用真实模型，也不消耗费用，返回演示数据
# 想先看界面长什么样，就先设成 1；接入真实模型时改回 0
LLM_MOCK=1

# 单次模型调用超时时间（秒）
LLM_TIMEOUT=120

# 用 DeepSeek 时自动关掉"思考模式"（它默认开着，会先输出一大段推理，既慢又计费）
# 1 = 关闭思考；0 = 保留。只影响 DeepSeek 官方接口，其它服务商不受影响
LLM_DISABLE_THINKING=1

# 上传文件大小上限（MB）
MAX_UPLOAD_MB=10

# ===== 联网采集岗位信息 =====
# 1 = 分析前先去网上抓这个岗位的真实招聘要求；0 = 只用你填的岗位名称
WEB_SEARCH_ENABLED=1

# auto = 先 DuckDuckGo、再 Bing（DuckDuckGo 的岗位结果质量更好）
# 国内网络连不上 DuckDuckGo 时会自动走 Bing，也可以写死 bing
WEB_SEARCH_PROVIDER=auto

# 每次取几条搜索结果去抓页面
WEB_SEARCH_MAX_RESULTS=5

# 最多抓几个页面（越多越慢）
WEB_FETCH_PAGES=2

# 抓网页的超时时间（秒）
WEB_TIMEOUT=12

# 送给模型的岗位参考材料最长多少字
WEB_MAX_CHARS=3000


# ===== 公开部署时的访问控制与数据保留 =====
# 每个 IP 每天免费用几次（访客自带密钥时不占这个额度）
RATE_LIMIT_PER_DAY=10
# 每分钟最多几次，防连点
RATE_LIMIT_PER_MINUTE=3
# 全站每天的总上限，防止被人刷爆
RATE_LIMIT_GLOBAL_PER_DAY=500
# 上传的简历和分析记录保留多少小时后自动删除（0 = 不删）
DATA_RETENTION_HOURS=72
# 公开部署建议设成 1：服务器不再垫付模型费用，必须访客自带密钥
REQUIRE_OWN_KEY=0
# 数据目录（容器部署时指向挂载盘，例如 /data/uploads）
# UPLOAD_DIR=/data/uploads


# ===== 常见服务商配置（改完记得重启后端）=====
#
# 【完全免费】OpenRouter（一个账号能用多家模型，有免费额度）
#   注册：https://openrouter.ai  然后到这里建 Key：https://openrouter.ai/keys
#   免费模型很多，下面这个是中文比较稳的，也可以去网站挑别的带 ":free" 的
# LLM_API_KEY=sk-or-v1-你的密钥
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=qwen/qwen3.8-27b:free
# LLM_MOCK=0
#
# 【便宜好用·国内直连】DeepSeek
#   模型名用 deepseek-flash（便宜快）或 deepseek-v4-pro（更强更贵）
#   注意：官方文档里的旧名字 deepseek-chat 已经换成 deepseek-flash
# LLM_API_KEY=sk-你的密钥
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-flash
# LLM_MOCK=0
#
# 【国内直连】通义千问（阿里云百炼）
# LLM_API_KEY=sk-你的密钥
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_MOCK=0
#
# 【完全免费·不联网】本地模型（先装 Ollama，再 ollama pull qwen2.5:7b）
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_MOCK=0
